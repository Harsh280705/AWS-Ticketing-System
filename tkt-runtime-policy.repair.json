{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Sid":  "TicketTableAccess",
                          "Resource":  [
                                           "arn:aws:dynamodb:ap-south-1:830118047383:table/tkt-tickets",
                                           "arn:aws:dynamodb:ap-south-1:830118047383:table/tkt-tickets/index/*"
                                       ],
                          "Action":  [
                                         "dynamodb:DescribeTable",
                                         "dynamodb:GetItem",
                                         "dynamodb:PutItem",
                                         "dynamodb:UpdateItem",
                                         "dynamodb:DeleteItem",
                                         "dynamodb:Query",
                                         "dynamodb:Scan",
                                         "dynamodb:BatchGetItem",
                                         "dynamodb:BatchWriteItem"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "TicketAttachmentsAccess",
                          "Resource":  "arn:aws:s3:::tkt-attachments-830118047383-ap-south-1/attachments/*",
                          "Action":  [
                                         "s3:GetObject",
                                         "s3:PutObject"
                                     ]
                      }
                  ]
}