{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TicketTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:830118047383:table/tkt-tickets"
    },
    {
      "Sid": "TicketAttachmentsAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::tkt-attachments-830118047383-ap-south-1/attachments/*"
    }
  ]
}