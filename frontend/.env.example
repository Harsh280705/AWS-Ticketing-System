# Local defaults. Copy to `.env.local` and fill in after Stage C approval.
# Uses the supplement's required variable names. No secrets — the SPA client
# has no client secret. Never commit real values.

# Backend base URL (local Express fallback or deployed API Gateway HTTP API)
VITE_API_URL=http://localhost:3000

# Cognito Hosted UI (leave AUTHORITY + CLIENT_ID empty for local demo mode)
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/callback

# Optional extras (sane defaults built in when empty)
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPE=openid email profile
